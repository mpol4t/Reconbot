{
  "name": "reconbot-operator-console",
  "version": "0.1.0",
  "productName": "ReconBot",
  "private": true,
  "description": "Desktop workspace for reconnaissance, evidence review and focused security validation",
  "main": "out/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ensure:python-deps": "if [ -n \"$RECONBOT_PYTHON\" ]; then \"$RECONBOT_PYTHON\" -m pip install -r ../requirements.txt; else python3 -m venv ../.venv && ../.venv/bin/python -m pip install -r ../requirements.txt; fi",
    "predev": "npm run ensure:python-deps",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test:e2e": "rm -f test-results/console-errors.json && npm run build:e2e && playwright test --config=e2e/playwright.config.ts",
    "build:e2e": "tsc --noEmit && electron-vite build",
    "prebuild": "npm run ensure:python-deps",
    "build": "tsc --noEmit && electron-vite build",
    "rebuild:pty": "electron-rebuild -f -w node-pty",
    "test:unit": "node --test tests/*.test.cjs",
    "build:backend": "../.venv/bin/python scripts/build-backend.py",
    "package:mac": "npm run build:backend && npm run build:e2e && npm run build:licenses && electron-builder --mac --publish never",
    "package:linux": "npm run build:backend && npm run build:e2e && npm run build:licenses && electron-builder --linux --publish never",
    "build:licenses": "node scripts/build-licenses.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cytoscape": "^3.30.4",
    "d3-force": "^3.0.0",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.61.1",
    "@types/d3-force": "^3.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.7"
  },
  "author": {
    "name": "Polat"
  },
  "build": {
    "appId": "dev.reconbot.console",
    "productName": "ReconBot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/reconbot-icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "build/backend/reconbot-backend",
        "to": "backend"
      },
      {
        "from": "resources/defaults",
        "to": "defaults"
      },
      {
        "from": "build/licenses",
        "to": "licenses"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/reconbot-icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "linux": {
      "icon": "resources/icons",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "reconbot",
      "maintainer": "Polat",
      "vendor": "Polat",
      "syncDesktopName": true
    },
    "artifactName": "ReconBot-${version}-${os}-${arch}.${ext}",
    "deb": {
      "compression": "gz",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2"
      ]
    }
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "homepage": "https://github.com/mpol4t/Reconbot",
  "desktopName": "reconbot.desktop",
  "license": "GPL-3.0-only"
}
